@model RoomDto
@{
    ViewData["Title"] = "حذف غرفة";
}

<div class="card border-danger" style="max-width:600px;">
    <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle"></i> تأكيد حذف الغرفة</div>
    <div class="card-body">
        <p>هل أنت متأكد من رغبتك في حذف الغرفة التالية؟</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">الفندق</dt><dd class="col-sm-8">@Model.HotelName</dd>
            <dt class="col-sm-4">رقم الغرفة</dt><dd class="col-sm-8">@Model.RoomNumber</dd>
            <dt class="col-sm-4">النوع</dt><dd class="col-sm-8">@Model.RoomType</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> نعم، حذف نهائي</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</div>
