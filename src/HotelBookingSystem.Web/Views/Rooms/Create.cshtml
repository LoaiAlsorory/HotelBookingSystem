@model CreateRoomDto
@{
    ViewData["Title"] = "إضافة غرفة";
}

<div class="card" style="max-width:650px;">
    <div class="card-header"><i class="bi bi-door-open"></i> إضافة غرفة جديدة</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="HotelId" class="form-label">الفندق</label>
                <select asp-for="HotelId" asp-items="@(ViewBag.Hotels as SelectList)" class="form-select">
                    <option value="">-- اختر الفندق --</option>
                </select>
                <span asp-validation-for="HotelId" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RoomNumber" class="form-label">رقم الغرفة</label>
                    <input asp-for="RoomNumber" class="form-control" />
                    <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="RoomType" class="form-label">نوع الغرفة</label>
                    <input asp-for="RoomType" class="form-control" placeholder="مفردة / مزدوجة / جناح" />
                    <span asp-validation-for="RoomType" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PricePerNight" class="form-label">السعر لكل ليلة</label>
                    <input asp-for="PricePerNight" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Capacity" class="form-label">السعة (عدد الأفراد)</label>
                    <input asp-for="Capacity" type="number" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">رابط صورة الغرفة</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="IsAvailable" class="form-check-input" />
                <label asp-for="IsAvailable" class="form-check-label">متاحة للحجز</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
