@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card bg-users">
            <div>
                <div class="stat-value">@Model.UsersCount</div>
                <div>المستخدمون</div>
            </div>
            <i class="bi bi-people stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card bg-hotels">
            <div>
                <div class="stat-value">@Model.HotelsCount</div>
                <div>الفنادق</div>
            </div>
            <i class="bi bi-building-fill stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card bg-rooms">
            <div>
                <div class="stat-value">@Model.RoomsCount</div>
                <div>الغرف</div>
            </div>
            <i class="bi bi-door-open stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card bg-bookings">
            <div>
                <div class="stat-value">@Model.BookingsCount</div>
                <div>الحجوزات</div>
            </div>
            <i class="bi bi-journal-check stat-icon"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-building-fill me-1"></i> الفنادق المسجّلة
            </div>
            <div class="card-body">
                @if (!Model.Hotels.Any())
                {
                    <p class="text-muted mb-0">لا توجد فنادق مسجّلة حاليًا.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var hotel in Model.Hotels)
                        {
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <img src="@(string.IsNullOrEmpty(hotel.ImageUrl) ? "https://placehold.co/400x200?text=Hotel" : hotel.ImageUrl)" class="card-img-top" style="height:140px;object-fit:cover;" alt="@hotel.Name" />
                                    <div class="card-body">
                                        <h6 class="card-title mb-1">@hotel.Name</h6>
                                        <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @hotel.City</p>
                                        <p class="small mb-0"><i class="bi bi-star-fill text-warning"></i> @hotel.Rating &nbsp; | &nbsp; <i class="bi bi-door-open"></i> @hotel.RoomsCount غرفة</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-journal-check me-1"></i> أحدث الحجوزات</span>
                <span class="fw-bold text-success">إجمالي الإيرادات: @Model.TotalRevenue.ToString("N0", CultureInfo.InvariantCulture) ريال</span>
            </div>
            <ul class="list-group list-group-flush">
                @if (!Model.RecentBookings.Any())
                {
                    <li class="list-group-item text-muted">لا توجد حجوزات بعد.</li>
                }
                else
                {
                    @foreach (var b in Model.RecentBookings)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@b.UserName</div>
                                <small class="text-muted">@b.HotelName - غرفة @b.RoomNumber</small>
                            </div>
                            <span class="badge badge-status-@b.Status.ToLower()">@b.Status</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>
