@model BookingDto
@{
    ViewData["Title"] = "حذف حجز";
}

<div class="card border-danger" style="max-width:600px;">
    <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle"></i> تأكيد حذف الحجز</div>
    <div class="card-body">
        <p>هل أنت متأكد من رغبتك في حذف الحجز التالي؟</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">رقم الحجز</dt><dd class="col-sm-8">@Model.Id</dd>
            <dt class="col-sm-4">المستخدم</dt><dd class="col-sm-8">@Model.UserName</dd>
            <dt class="col-sm-4">الغرفة</dt><dd class="col-sm-8">@Model.HotelName - @Model.RoomNumber</dd>
            <dt class="col-sm-4">الحالة</dt><dd class="col-sm-8"><span class="badge badge-status-@Model.Status.ToLower()">@BookingStatusDisplay.ToArabic(Model.Status)</span></dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> نعم، حذف نهائي</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</div>
