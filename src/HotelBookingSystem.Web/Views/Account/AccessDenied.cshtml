@{
    ViewData["Title"] = "غير مصرح بالدخول";
    Layout = "_LoginLayout";
}

<div class="auth-card text-center">
    <i class="bi bi-shield-lock display-1 text-danger"></i>
    <h4 class="mt-3">غير مصرح لك بالدخول</h4>
    <p class="text-muted">لا تملك الصلاحية الكافية للوصول إلى هذه الصفحة.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">
        <i class="bi bi-box-arrow-in-left"></i> العودة لتسجيل الدخول
    </a>
</div>
