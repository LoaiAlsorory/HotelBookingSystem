@model UpdateUserDto
@{
    ViewData["Title"] = "تعديل مستخدم";
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><i class="bi bi-pencil"></i> تعديل بيانات المستخدم</div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.UserId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input class="form-control" value="@ViewBag.Email" disabled />
                <div class="form-text">لا يمكن تعديل البريد الإلكتروني بعد الإنشاء.</div>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
