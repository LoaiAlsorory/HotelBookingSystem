@model UserDto
@{
    ViewData["Title"] = "تفاصيل المستخدم";
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><i class="bi bi-person"></i> تفاصيل المستخدم</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">المعرّف</dt><dd class="col-sm-8">@Model.Id</dd>
            <dt class="col-sm-4">الاسم الكامل</dt><dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">البريد الإلكتروني</dt><dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">رقم الهاتف</dt><dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>
            <dt class="col-sm-4">الدور</dt><dd class="col-sm-8"><span class="badge bg-secondary">@Model.Role</span></dd>
            <dt class="col-sm-4">تاريخ الإنشاء</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> تعديل</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right"></i> رجوع للقائمة</a>
    </div>
</div>
